<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>allmusic</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Um único .exe, já com o runtime do .NET: não exige nada instalado além do WebView2 do Windows -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <RootNamespace>AllMusic</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- O pacote WebView2 traz também a DLL de WPF, que não usamos -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="AllMusic.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- A interface e o motor de Spotify viajam dentro do .exe. O motor precisa ser compilado
         antes, com cargo (modo release) na pasta engine. -->
    <EmbeddedResource Include="..\ui\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\engine\target\release\allmusic-engine.exe" LogicalName="allmusic-engine.exe" />
  </ItemGroup>

</Project>
